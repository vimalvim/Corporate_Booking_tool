# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL). Leave USE_SQLITE=True to run without MySQL for a quick demo.
USE_SQLITE=True
DB_NAME=corporate_travel
DB_USER=travel_admin
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS - your frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT lifetimes (minutes / days)
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7
